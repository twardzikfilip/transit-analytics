{
  "uid": "transit-backend",
  "title": "Transit Backend",
  "tags": [
    "transit-analytics",
    "backend"
  ],
  "timezone": "browser",
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Backend requests",
      "description": "Each HTTP request handled by transit-backend (newest first, up to 200). Click a Trace link to open the full trace.",
      "gridPos": {
        "h": 22,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"transit-backend\" && kind=server} | select(span.method, span.uri, span.status, span.outcome)",
          "tableType": "spans",
          "limit": 200,
          "spss": 1
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Trace Name": true,
              "Name": true,
              "kind": true,
              "service.name": true
            },
            "indexByName": {
              "Start time": 0,
              "method": 1,
              "uri": 2,
              "status": 3,
              "outcome": 4,
              "Duration": 5,
              "Trace Service": 6,
              "Span ID": 7,
              "traceIdHidden": 8
            },
            "renameByName": {
              "Start time": "Time",
              "method": "Method",
              "uri": "Endpoint",
              "status": "Status",
              "outcome": "Outcome",
              "Trace Service": "Started by",
              "Span ID": "Trace"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^2\\d\\d$",
                      "result": {
                        "color": "green",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^3\\d\\d$",
                      "result": {
                        "color": "blue",
                        "index": 1
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^4\\d\\d$",
                      "result": {
                        "color": "orange",
                        "index": 2
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^5\\d\\d$",
                      "result": {
                        "color": "red",
                        "index": 3
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Method"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 190
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Outcome"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ns"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Started by"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 200
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Time",
            "desc": true
          }
        ]
      }
    }
  ]
}
