# Settings of docker-compose.prod.yml, in .env on the server (never committed). tools/server-env.sh makes it, with
# random secrets.
# The site's domain name
SITE_ADDRESS=
# Released versions (tools/version.sh)
APP_VERSION=1.0.0
RECORDER_VERSION=1.0.0
GRAFANA_VERSION=1.0.0
# Database: the owner, the recorder's role and the read-only one for Grafana
DB_PASSWORD=
RECORDER_DB_PASSWORD=
GRAFANA_DB_PASSWORD=
# Grafana's user admin
GRAFANA_ADMIN_PASSWORD=
# Signs the sign-in tokens; at least 32 characters
JWT_SECRET=
# What the seeded users' passwords are replaced with; at least 10 characters
ADMIN_PASSWORD=
GUEST_PASSWORD=
# Who owns backend/data (id -u, id -g)
RECORDER_UID=1000
RECORDER_GID=1000
